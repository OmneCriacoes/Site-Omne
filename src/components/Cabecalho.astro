---
import { getCollection } from 'astro:content';
import logo from '../assets/logo-omne.svg';

interface Props {
  atual?: string;
}

const { atual } = Astro.props;
const servicos = (await getCollection('servicos')).sort((a, b) => a.data.ordem - b.data.ordem);
const colunas = [servicos.slice(0, 3), servicos.slice(3)];
const palavras = [
  { href: '/projetos/', rotulo: 'Projetos' },
  { href: '/sobre/', rotulo: 'Sobre' },
  { href: '/sobre/#clientes', rotulo: 'Clientes' },
];
const corrente = (rotulo: string) => (atual === rotulo ? 'page' : undefined);
---

<header class="nav nav--centre">
  <div class="wrap nav__bar">
    <a class="skip-link" href="#top">Pular para o conteúdo</a>
    <a class="nav__logo" href="/"><img src={logo.src} alt="Omne Criações" width="94" height="40" /></a>
    <nav class="nav__links" aria-label="Principal">
      <div class="nav__item">
        <a class="nav__link" href="/servicos/" aria-current={corrente('Serviços')}>Serviços <svg class="chev" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 4.5l3 3 3-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg></a>
        <div class="nav__menu">
          <div class="wrap grid">
            {colunas.map((coluna, i) => (
              <div class="menu-col span-3">
                <p class="t-label">{i === 0 ? 'Peças' : 'Espaços e projetos'}</p>
                {coluna.map((s) => (
                  <a href={`/servicos/#${s.data.categoria}`}>{s.data.titulo}<span>{s.data.menu}</span></a>
                ))}
              </div>
            ))}
          </div>
        </div>
      </div>
      {palavras.map((p) => (
        <div class="nav__item"><a class="nav__link" href={p.href} aria-current={corrente(p.rotulo)}>{p.rotulo}</a></div>
      ))}
    </nav>
    <div class="nav__actions">
      <a class="btn btn--primary" href="/orcamento/">Pedir orçamento</a>
    </div>
    <button class="nav__toggle" type="button" aria-expanded="false" aria-label="Menu">
      <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M2 5h14M2 13h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
    </button>
  </div>
</header>

<style>
  .nav__logo img { display: block; height: 40px; width: auto; }
  @media (max-width: 639px) { .nav__logo img { height: 32px; } }
</style>
