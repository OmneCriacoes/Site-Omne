---
import type { SiteSettings } from '@domain/entities';
import Button from '@components/ui/Button.astro';
import SectionHeading from '@components/ui/SectionHeading.astro';

interface Props {
  settings: SiteSettings;
  showLink?: boolean;
  headingLevel?: 'h1' | 'h2';
}

const { settings, showLink = true, headingLevel = 'h2' } = Astro.props;
---

<section class="section">
  <div class="container grid">
    <div>
      <SectionHeading eyebrow="Sobre a Omne" title={settings.aboutTitle} as={headingLevel} />
    </div>
    <div class="text">
      <p data-sk="text">{settings.aboutText}</p>
      {showLink && <Button href="/sobre" variant="ghost">Conheça nossa história</Button>}
    </div>
    {
      settings.stats.length > 0 && (
        <dl class="stats">
          {settings.stats.map((stat) => (
            <div>
              <dt data-sk="text">{stat.label}</dt>
              <dd data-sk="text">{stat.value}</dd>
            </div>
          ))}
        </dl>
      )
    }
  </div>
</section>

<style>
  .section {
    padding-block: var(--space-9);
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6) var(--space-8);
  }

  .text {
    display: grid;
    align-content: start;
    gap: var(--space-5);
    color: var(--color-ink-soft);
    font-size: var(--text-lg);
  }

  .text :global(.btn) {
    justify-self: start;
  }

  .stats {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: var(--space-5);
    margin: 0;
    padding-top: var(--space-7);
    border-top: 1px solid var(--color-line);
  }

  .stats div {
    display: flex;
    flex-direction: column-reverse;
    gap: var(--space-2);
  }

  dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    line-height: 1;
  }

  dt {
    color: var(--color-ink-soft);
    font-size: var(--text-sm);
  }

  @media (max-width: 760px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
