---
import type { Project } from '@domain/entities';
import ProjectCard from '@components/ui/ProjectCard.astro';

/**
 * Uma seção de projetos em linhas sempre cheias: até três numa linha só (uma tela), de quatro a seis em duas
 * linhas (duas telas, uma por linha). Mais de seis ficam para a página do portfólio.
 */
interface Props {
  id: string;
  title: string;
  text?: string;
  projects: readonly Project[];
  link?: { href: string; label: string };
}

const { id, title, text, projects, link } = Astro.props;
const list = projects.slice(0, 6);
const rows = list.length <= 3 ? [list] : list.length === 4 ? [list.slice(0, 2), list.slice(2)] : [list.slice(0, 3), list.slice(3)];
const spanOf = (row: readonly Project[]) => (row.length === 1 ? 'span-6' : row.length === 2 ? 'span-6' : 'span-4');
const ratioOf = (row: readonly Project[]) => '4 / 3';
---

<section class:list={['section', { g2: rows.length > 1 }]} id={id} aria-labelledby={`${id}-h`}>
  <div class="wrap">
    <div class="group">
      <div class="section-head section-head--row">
        <div><h2 id={`${id}-h`}>{title}</h2>{text && <p>{text}</p>}</div>
        {link && <a class="link" href={link.href}>{link.label}</a>}
      </div>
      <div class="grid">{rows[0].map((p) => <ProjectCard project={p} span={spanOf(rows[0])} ratio={ratioOf(rows[0])} />)}</div>
    </div>
    {rows[1] && <div class="grid">{rows[1].map((p) => <ProjectCard project={p} span={spanOf(rows[1])} ratio={ratioOf(rows[1])} />)}</div>}
  </div>
</section>
