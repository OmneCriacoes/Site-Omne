---
import type { ContactInfo, Service } from '@domain/entities';
import { ContactService } from '@application/ContactService';

interface Props {
  services: readonly Service[];
  contact: ContactInfo;
  selectedService?: string;
}

const { services, contact, selectedService } = Astro.props;
const phone = ContactService.normalizePhone(contact.whatsapp);
---

<!-- O formulário do kit: o system.js confere os campos e mostra cada erro sob o seu campo. Com tudo certo, o navegador
     abre o WhatsApp da Omne numa aba nova; o QuoteForm só escreve a mensagem no campo "text" antes do envio. Os campos
     visíveis não têm name, então só a mensagem vai para o wa.me. Sem JavaScript o WhatsApp abre sem a mensagem. -->
<form class="form" action={`https://wa.me/${phone}`} method="get" target="_blank" data-quote-form data-whatsapp={contact.whatsapp} data-email={contact.email} data-fix="Campos a conferir: {n}." novalidate>
  <input type="hidden" name="text" value="" />
  <div class="field">
    <label for="q-name">Nome</label>
    <input id="q-name" data-field="name" type="text" autocomplete="name" required aria-describedby="q-name-err" />
    <p class="field__error" id="q-name-err" hidden>Escreva o seu nome.</p>
  </div>
  <div class="field">
    <label for="q-service">Serviço</label>
    <select id="q-service" data-field="service" required aria-describedby="q-service-err">
      <option value="">Escolha um serviço</option>
      {services.map((s) => <option value={s.title} selected={s.slug === selectedService}>{s.title}</option>)}
      <option value="Ainda não sei">Ainda não sei</option>
    </select>
    <p class="field__error" id="q-service-err" hidden>Escolha o serviço, ou "Ainda não sei".</p>
  </div>
  <div class="field">
    <label for="q-location">Local e cidade</label>
    <input id="q-location" data-field="location" type="text" autocomplete="address-level2" />
  </div>
  <div class="field">
    <label for="q-date">Data do evento</label>
    <input id="q-date" data-field="eventDate" type="text" autocomplete="off" />
  </div>
  <div class="field field--full">
    <label for="q-message">O que você imagina</label>
    <textarea id="q-message" data-field="message" rows="3" required aria-describedby="q-message-err"></textarea>
    <p class="field__error" id="q-message-err" hidden>Conte em uma frase o que você quer fazer.</p>
  </div>
  <div class="btn-row"><button class="btn btn--primary" type="submit">Pedir orçamento</button></div>
  <p class="form__status" role="status" data-form-status></p>
  <p class="t-small muted">O WhatsApp abre com a mensagem pronta. É só enviar.</p>
</form>

<script>
  import { ContactService } from '@application/ContactService';
  import { QuoteForm } from '@scripts/quote-form';

  document.querySelectorAll<HTMLFormElement>('[data-quote-form]').forEach((form) => {
    new QuoteForm(form, new ContactService(form.dataset.whatsapp ?? '', form.dataset.email ?? '')).start();
  });
</script>
