---
import Button from '@components/ui/Button.astro';

interface Props {
  title?: string;
  text?: string;
  whatsappLink: string;
}

const {
  title = 'Tem um projeto em mente?',
  text = 'Conte a data, o local e a ideia. Respondemos com uma proposta clara, com prazo e valores.',
  whatsappLink,
} = Astro.props;
---

<section class="cta">
  <div class="container inner">
    <div class="text">
      <h2 data-sk="text">{title}</h2>
      <p data-sk="text">{text}</p>
    </div>
    <div class="actions">
      <Button href={whatsappLink} target="_blank" rel="noopener">Chamar no WhatsApp</Button>
      <Button href="/contato" variant="outline">Formulário de orçamento</Button>
    </div>
  </div>
</section>

<style>
  .cta {
    padding-block: var(--space-8);
    background: var(--color-ink);
    color: var(--color-bg);
    --sk-base: color-mix(in srgb, var(--color-bg) 14%, var(--color-ink));
    --sk-highlight: color-mix(in srgb, var(--color-bg) 26%, var(--color-ink));
  }

  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
  }

  .text {
    display: grid;
    gap: var(--space-3);
    max-width: 36rem;
  }

  h2 {
    font-size: var(--text-3xl);
  }

  p {
    opacity: 0.8;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
</style>
