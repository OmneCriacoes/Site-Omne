---
import type { Image } from '@domain/entities';

/** O hero sorteado (split do kit): as palavras à esquerda, a foto do trabalho à direita, uma tela só. */
interface Props {
  title: string;
  lead: string;
  image: Image;
  subject: string;
  position?: string;
  secondary?: { href: string; label: string };
}

const { title, lead, image, subject, position = '50% 50%', secondary } = Astro.props;
---

<section class="hero hero--split" data-enter aria-labelledby="hero-h">
  <div class="wrap"><div class="hero-text grid hero__grid">
    <div class="hero__text span-5">
      <h1 id="hero-h">{title}</h1>
      <p class="hero__lead">{lead}</p>
      <div class="btn-row">
        <a class="btn btn--primary" href="/contato">Pedir orçamento</a>
        {secondary && <a class="btn btn--secondary" href={secondary.href}>{secondary.label}</a>}
      </div>
    </div>
    <div class="hero__media span-6 start-7">
      <img src={image.src} alt={image.alt} style={`--ly-pos: ${position}`} fetchpriority="high" data-source="client" data-subject={subject} />
    </div>
  </div></div>
</section>
