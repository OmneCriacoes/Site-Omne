---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/** O hero das páginas internas: o split do kit, as palavras à esquerda e a foto do trabalho à direita. */
interface Props {
  titulo: string;
  texto: string;
  foto: ImageMetadata;
  alt: string;
  assunto: string;
  posicao?: string;
  secundario?: { href: string; rotulo: string };
}

const { titulo, texto, foto, alt, assunto, posicao = '50% 50%', secundario } = Astro.props;
---

<section class="hero hero--split" data-enter aria-labelledby="hero-h">
  <div class="wrap"><div class="hero-text grid hero__grid">
    <div class="hero__text span-5">
      <h1 id="hero-h">{titulo}</h1>
      <p class="hero__lead">{texto}</p>
      <div class="btn-row">
        <a class="btn btn--primary" href="/orcamento/">Pedir orçamento</a>
        {secundario && <a class="btn btn--secondary" href={secundario.href}>{secundario.rotulo}</a>}
      </div>
    </div>
    <div class="hero__media span-6 start-7">
      <Image src={foto} widths={[700, 1000, 1400]} sizes="(min-width: 1024px) 1000px, 700px" alt={alt} style={`--ly-pos: ${posicao}`} loading="eager" fetchpriority="high" data-source="client" data-subject={assunto} />
    </div>
  </div></div>
</section>
