---
import { container } from '@core/container';
import { isCurrent, mainNavigation } from '@core/navigation';

interface Props {
  siteName: string;
}

const { siteName } = Astro.props;
const { pathname } = Astro.url;
const services = await container.catalog.list();
const columns = [services.slice(0, 3), services.slice(3)];
const current = (href: string) => (isCurrent(href, pathname) ? 'page' : undefined);
---

<header class="nav nav--centre">
  <div class="wrap nav__bar">
    <a class="skip-link" href="#top">Pular para o conteúdo</a>
    <a class="nav__logo" href="/"><img src="/uploads/logo-omne.svg" alt={siteName} width="94" height="40" /></a>
    <nav class="nav__links" aria-label="Principal">
      {mainNavigation.map((item, i) =>
        i === 0 ? (
          <div class="nav__item">
            <a class="nav__link" href={item.href} aria-current={current(item.href)}>{item.label} <svg class="chev" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 4.5l3 3 3-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg></a>
            <div class="nav__menu">
              <div class="wrap grid">
                {columns.map((column, c) => (
                  <div class="menu-col span-3">
                    <p class="t-label">{c === 0 ? 'Peças' : 'Espaços e projetos'}</p>
                    {column.map((s) => <a href={`/servicos/${s.slug}`}>{s.title}</a>)}
                  </div>
                ))}
              </div>
            </div>
          </div>
        ) : (
          <div class="nav__item"><a class="nav__link" href={item.href} aria-current={current(item.href)}>{item.label}</a></div>
        ),
      )}
    </nav>
    <div class="nav__actions">
      <a class="btn btn--primary" href="/contato">Pedir orçamento</a>
    </div>
    <button class="nav__toggle" type="button" aria-expanded="false" aria-label="Menu">
      <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M2 5h14M2 13h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
    </button>
  </div>
</header>

<style>
  .nav__logo img { display: block; height: 40px; width: auto; }
  @media (max-width: 639px) { .nav__logo img { height: 32px; } }
</style>
