---
import type { SiteSettings } from '@domain/entities';
import { container } from '@core/container';

interface Props {
  settings: SiteSettings;
}

const { settings } = Astro.props;
const { contact } = settings;
const year = new Date().getFullYear();
const [services, projects, whatsapp] = await Promise.all([
  container.catalog.list(),
  container.portfolio.featured(3),
  container.contact().then((c) => c.whatsappLink()),
]);
---

<footer class="footer closing" id="contact" aria-labelledby="close-h">
  <div class="wrap">
    <div class="closing__cta close--type">
      <div class="section-head">
        <h2 id="close-h">A sua peça começa num pedido de orçamento</h2>
        <p>Diga o que imagina, o local e a data. O WhatsApp abre com a mensagem pronta para a oficina.</p>
      </div>
      <a class="btn btn--primary btn--xl" href="/contato">Pedir orçamento<svg class="m-arrow" viewBox="0 0 12 12" aria-hidden="true"><path class="m-arrow__stem" d="M1 6h8" /><path class="m-arrow__head" d="M4.5 2.5 8 6l-3.5 3.5" /></svg></a>
    </div>
    <div class="closing__links">
      <div class="grid">
        <div class="span-4 stack-4">
          <a class="nav__logo" href="/"><img src="/uploads/logo-omne.svg" alt={settings.name} width="94" height="40" /></a>
          <p class="footer__lede">{settings.tagline}, feitas em {contact.city}.</p>
        </div>
        <div class="span-2 footer__col">
          <h3>Serviços</h3>
          <ul>{services.map((s) => <li><a href={`/servicos/${s.slug}`}>{s.title}</a></li>)}</ul>
        </div>
        <div class="span-2 footer__col">
          <h3>Portfólio</h3>
          <ul>
            <li><a href="/portfolio">Todos os projetos</a></li>
            {projects.map((p) => <li><a href={`/portfolio/${p.slug}`}>{p.title}</a></li>)}
          </ul>
        </div>
        <div class="span-2 footer__col">
          <h3>Sobre</h3>
          <ul>
            <li><a href="/sobre">A oficina</a></li>
            <li><a href="/sobre#clientes">Clientes</a></li>
          </ul>
        </div>
        <div class="span-2 footer__col">
          <h3>Contato</h3>
          <ul>
            <li><a href={whatsapp}>WhatsApp</a></li>
            <li><a class="footer__email" href={`mailto:${contact.email}`}>{contact.email}</a></li>
            <li>{contact.city}</li>
          </ul>
        </div>
      </div>
      <div class="footer__legal">
        <span>&copy; {year} {settings.name}</span>
        <div class="socials"></div>
        <span class="t-small">Marcas e logos de clientes pertencem aos seus donos.</span>
      </div>
    </div>
  </div>
</footer>

<style>
  .closing .nav__logo img { display: block; height: 40px; width: auto; }
  .footer__email { overflow-wrap: anywhere; }
</style>
