---
import type { SiteSettings } from '@domain/entities';
import { mainNavigation } from '@core/navigation';
import Icon from '@components/ui/Icon.astro';

interface Props {
  settings: SiteSettings;
  whatsappLink: string;
}

const { settings, whatsappLink } = Astro.props;
const { contact } = settings;
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container grid">
    <div class="about">
      <p class="name" data-sk="text">{settings.name}</p>
      <p class="tagline" data-sk="text">{settings.description}</p>
    </div>

    <nav aria-label="Rodapé">
      <p class="label" data-sk="text">Navegação</p>
      <ul>
        {
          mainNavigation.map((item) => (
            <li>
              <a href={item.href} data-sk="text">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div>
      <p class="label" data-sk="text">Contato</p>
      <ul>
        <li>
          <a href={whatsappLink} target="_blank" rel="noopener" data-sk="text">
            <Icon name="chat" size={16} /> WhatsApp {contact.phoneDisplay}
          </a>
        </li>
        <li>
          <a href={`mailto:${contact.email}`} data-sk="text"><Icon name="mail" size={16} /> {contact.email}</a>
        </li>
        <li data-sk="text"><Icon name="pin" size={16} /> {contact.city}</li>
      </ul>
    </div>
  </div>

  <div class="container legal">
    <p data-sk="text">{year} {settings.name}. Todos os direitos reservados.</p>
  </div>
</footer>

<style>
  .footer {
    margin-top: var(--space-9);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-line);
    background: var(--color-surface-alt);
    font-size: var(--text-sm);
  }

  .grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1.4fr;
    gap: var(--space-7);
  }

  .name {
    margin-bottom: var(--space-3);
    font-family: var(--font-display);
    font-size: var(--text-xl);
  }

  .tagline {
    max-width: 28rem;
    color: var(--color-ink-soft);
  }

  .label {
    margin-bottom: var(--space-3);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--eyebrow-tracking);
    text-transform: uppercase;
  }

  ul {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li,
  a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-ink-soft);
    text-decoration: none;
    word-break: break-word;
  }

  a:hover {
    color: var(--color-ink);
  }

  .legal {
    margin-top: var(--space-7);
    padding-block: var(--space-5);
    border-top: 1px solid var(--color-line);
    color: var(--color-ink-soft);
    font-size: var(--text-xs);
  }

  @media (max-width: 760px) {
    .grid {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
  }
</style>
