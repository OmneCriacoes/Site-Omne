---
import { THEME_LABELS } from '@domain/entities';

const themes = Object.entries(THEME_LABELS);
---

<aside class="switcher" aria-label="Propostas visuais">
  <p>Proposta visual</p>
  <div class="options" role="group">
    {
      themes.map(([id, label]) => (
        <button type="button" value={id} aria-pressed="false" data-theme-option>
          {label}
        </button>
      ))
    }
  </div>
</aside>

<script>
  import { THEME_LABELS } from '@domain/entities';
  import { ThemePreview, browserStore } from '@scripts/theme-preview';

  const preview = new ThemePreview(document.documentElement, Object.keys(THEME_LABELS), browserStore);
  preview.bind(document.querySelectorAll<HTMLButtonElement>('[data-theme-option]'));
</script>

<style>
  .switcher {
    position: fixed;
    left: var(--gutter);
    bottom: var(--space-5);
    z-index: 40;
    display: grid;
    gap: var(--space-2);
    padding: var(--space-3);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    box-shadow: 0 10px 30px rgb(0 0 0 / 0.15);
    font-size: var(--text-xs);
  }

  p {
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .options {
    display: flex;
    gap: var(--space-1);
  }

  button {
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-sm);
    background: transparent;
    cursor: pointer;
  }

  button[aria-pressed='true'] {
    border-color: var(--color-accent);
    background: var(--color-accent);
    color: var(--color-accent-ink);
  }
</style>
