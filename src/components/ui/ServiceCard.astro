---
import type { Service } from '@domain/entities';
import Icon from './Icon.astro';
import Media from './Media.astro';

interface Props {
  service: Service;
  index: number;
}

const { service, index } = Astro.props;
const number = String(index + 1).padStart(2, '0');
---

<article class="card">
  <a class="link" href={`/servicos/${service.slug}`}>
    <Media image={service.cover} ratio="4 / 5" />
    <div class="body">
      <span class="number" data-sk="text">{number}</span>
      <h3 class="title" data-sk="text">{service.title}</h3>
      <p class="summary" data-sk="text">{service.summary}</p>
      <span class="more" data-sk="text">Ver serviço <Icon name="arrow" size={16} /></span>
    </div>
  </a>
</article>

<style>
  .link {
    display: grid;
    gap: var(--space-4);
    height: 100%;
    text-decoration: none;
  }

  .link :global(.media img) {
    transition: transform 700ms var(--ease-out);
  }

  .link:hover :global(.media img) {
    transform: scale(1.04);
  }

  .body {
    display: grid;
    gap: var(--space-2);
  }

  .number {
    color: var(--color-accent);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--eyebrow-tracking);
  }

  .title {
    font-size: var(--text-xl);
  }

  .summary {
    color: var(--color-ink-soft);
    font-size: var(--text-sm);
  }

  .more {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    justify-self: start;
    margin-top: var(--space-2);
    color: var(--color-accent);
    font-size: var(--text-sm);
    font-weight: 600;
  }
</style>
