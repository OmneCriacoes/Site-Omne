---
import type { Project } from '@domain/entities';

/** Um projeto como tile aberto do kit: a foto em cima, o nome e o cliente embaixo, tudo um link. */
interface Props {
  project: Project;
  span: 'span-3' | 'span-4' | 'span-6';
  ratio?: string;
}

const { project, span, ratio = '4 / 3' } = Astro.props;
const line = [project.clientName, project.location].filter(Boolean).join(', ');
---

<a class={`tile ${span}`} href={`/portfolio/${project.slug}`} style={`--tile-ratio: ${ratio}`}>
  <div class="tile__media"><img src={project.cover.src} alt={project.cover.alt} loading="lazy" data-source="client" data-subject={project.title} /></div>
  <p class="t-card">{project.title}</p>
  {line && <p class="t-small muted">{line}</p>}
</a>
