---
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  as?: 'h1' | 'h2';
  align?: 'start' | 'center';
}

const { eyebrow, title, intro, as: Heading = 'h2', align = 'start' } = Astro.props;
---

<header class:list={['heading', `heading--${align}`]}>
  {eyebrow && <p class="eyebrow" data-sk="text">{eyebrow}</p>}
  <Heading class="title" data-sk="text">{title}</Heading>
  {intro && <p class="intro" data-sk="text">{intro}</p>}
  <slot />
</header>

<style>
  .heading {
    display: grid;
    gap: var(--space-4);
    max-width: 46rem;
    margin-bottom: var(--space-7);
  }

  .heading--center {
    margin-inline: auto;
    text-align: center;
    justify-items: center;
  }

  .eyebrow {
    color: var(--color-accent);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--eyebrow-tracking);
    text-transform: uppercase;
  }

  .title {
    font-size: var(--text-3xl);
  }

  h1.title {
    font-size: var(--text-4xl);
  }

  .intro {
    color: var(--color-ink-soft);
    font-size: var(--text-lg);
  }
</style>
