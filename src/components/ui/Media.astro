---
import type { Image } from '@domain/entities';

interface Props {
  image: Image;
  ratio?: string;
  eager?: boolean;
  sizes?: string;
  class?: string;
}

const { image, ratio = '4 / 3', eager = false, class: className } = Astro.props;
---

<figure class:list={['media', className]} style={`--ratio: ${ratio}`} data-sk="media">
  <img
    src={image.src}
    alt={image.alt}
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
    fetchpriority={eager ? 'high' : undefined}
  />
</figure>

<style>
  .media {
    margin: 0;
    aspect-ratio: var(--ratio);
    border-radius: var(--radius-md);
    background: var(--sk-base);
  }

  .media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
