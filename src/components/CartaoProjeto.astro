---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

/** Um projeto como tile aberto do kit: a foto em cima, o nome e o cliente embaixo, tudo um link. */
interface Props {
  projeto: CollectionEntry<'projetos'>;
  largura: 'span-3' | 'span-4' | 'span-6';
  proporcao?: string;
}

const { projeto, largura, proporcao = '4 / 3' } = Astro.props;
const { titulo, cliente, local, capa } = projeto.data;
const linha = [cliente, local].filter(Boolean).join(', ');
const larguraFoto = largura === 'span-6' ? 900 : 640;
---

<a class={`tile ${largura}`} href={`/projetos/${projeto.id}/`} style={`--tile-ratio: ${proporcao}`}>
  <div class="tile__media">
    <Image src={capa} widths={[larguraFoto, larguraFoto * 2]} sizes={`${larguraFoto}px`} alt={titulo} loading="lazy" data-source="client" data-subject={titulo} />
  </div>
  <p class="t-card">{titulo}</p>
  {linha && <p class="t-small muted">{linha}</p>}
</a>
