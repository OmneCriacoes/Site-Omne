---
import type { CollectionEntry } from 'astro:content';
import Midia from './Midia.astro';
import { rotuloCategoria } from '../lib/site';

interface Props {
  projeto: CollectionEntry<'projetos'>;
  grande?: boolean;
  prioridade?: boolean;
}

const { projeto, grande = false, prioridade = false } = Astro.props;
const { titulo, cliente, capa, categorias } = projeto.data;
---

<article class:list={['cartao', { grande }]} data-categorias={categorias.join(' ')}>
  <a href={`/projetos/${projeto.id}/`}>
    <Midia
      src={capa}
      alt={titulo}
      proporcao={grande ? '4 / 3' : '1 / 1'}
      tamanhos={grande ? '(max-width: 760px) 100vw, 60vw' : '(max-width: 760px) 50vw, 30vw'}
      prioridade={prioridade}
    />
    <div class="legenda">
      <h3>{titulo}</h3>
      <p>{[cliente, categorias.map(rotuloCategoria).join(', ')].filter(Boolean).join(' · ')}</p>
    </div>
  </a>
</article>

<style>
  .cartao a { display: grid; gap: 14px; color: inherit; text-decoration: none; }
  .cartao :global(.midia img) { transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1), opacity 0.45s ease; }
  .cartao a:hover :global(.midia img) { transform: scale(1.035); }
  .legenda { display: grid; gap: 4px; }
  .legenda h3 { font-size: 1.15rem; }
  .cartao a:hover h3 { color: var(--c-marca); }
  .legenda p { font-size: var(--t-pequeno); color: var(--c-suave); }
  .grande .legenda h3 { font-size: 1.45rem; }
  @media (prefers-reduced-motion: reduce) {
    .cartao a:hover :global(.midia img) { transform: none; }
  }
</style>
