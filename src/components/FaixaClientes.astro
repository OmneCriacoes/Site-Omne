---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

interface Props {
  titulo?: string;
}

const { titulo = 'Marcas e instituições que já confiaram na Omne' } = Astro.props;
const clientes = await getCollection('clientes');
---

<section class="secao clientes" aria-labelledby="titulo-clientes">
  <div class="container">
    <p class="rotulo" id="titulo-clientes">{titulo}</p>
    <ul>
      {clientes.map(({ data }) => (
        <li><Image src={data.logo} alt={data.nome} height={48} /></li>
      ))}
    </ul>
  </div>
</section>

<style>
  .clientes .container { display: grid; gap: 28px; }
  ul {
    list-style: none;
    margin: 0;
    padding: 28px 0 0;
    border-top: 1px solid var(--c-linha);
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
    gap: 32px 40px;
    align-items: center;
  }
  li { display: grid; place-items: center; height: 56px; }
  li :global(img) {
    max-height: 44px;
    max-width: 120px;
    width: auto;
    object-fit: contain;
    filter: grayscale(1);
    opacity: 0.6;
    transition: filter 0.3s, opacity 0.3s;
  }
  li:hover :global(img) { filter: none; opacity: 1; }
</style>
