---
import { getCollection } from 'astro:content';

const etapas = await getCollection('etapas');
---

<section class="secao processo" aria-labelledby="titulo-processo">
  <div class="container">
    <div class="cabecalho-secao">
      <div>
        <p class="rotulo">Como trabalhamos</p>
        <h2 id="titulo-processo">Da ideia à inauguração</h2>
      </div>
    </div>
    <ol>
      {etapas.map(({ data }, i) => (
        <li>
          <span class="passo">Etapa {i + 1}</span>
          <h3>{data.titulo}</h3>
          <p>{data.texto}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .processo { background: var(--c-tinta); color: #c3d5db; padding-block: var(--secao); margin-top: var(--secao); }
  .processo :global(h2), .processo h3 { color: #fff; }
  .processo .rotulo { color: var(--c-menta); }
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 32px;
    counter-reset: etapa;
  }
  li { display: grid; gap: 10px; align-content: start; padding-top: 20px; border-top: 2px solid #1f4a5a; }
  li:first-child { border-top-color: var(--c-menta); }
  .passo { font-size: 0.78rem; letter-spacing: 0.14em; text-transform: uppercase; color: #86a7b2; font-weight: 600; }
  @media (max-width: 900px) { ol { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 520px) { ol { grid-template-columns: 1fr; } }
</style>
