---
import { listaCategorias, site } from '../lib/site';
import { limparNumero } from '../lib/whatsapp';
---

<!-- O formulário do kit (system.js confere os campos e mostra cada erro sob o seu campo). Com os campos certos, o
     navegador abre o WhatsApp da Omne numa aba nova, com a mensagem montada no campo "text". Os campos visíveis não
     têm name: só a mensagem vai para o wa.me. Sem JavaScript o WhatsApp abre mesmo assim, sem a mensagem. -->
<form class="form" action={`https://wa.me/${limparNumero(site.whatsapp)}`} method="get" target="_blank" data-orcamento data-fix="Campos a conferir: {n}." novalidate>
  <input type="hidden" name="text" value="" />
  <div class="field">
    <label for="orc-nome">Nome</label>
    <input id="orc-nome" data-campo="nome" type="text" autocomplete="name" required aria-describedby="orc-nome-err" />
    <p class="field__error" id="orc-nome-err" hidden>Escreva o seu nome.</p>
  </div>
  <div class="field">
    <label for="orc-empresa">Empresa ou evento</label>
    <input id="orc-empresa" data-campo="empresa" type="text" autocomplete="organization" />
  </div>
  <div class="field">
    <label for="orc-servico">Serviço</label>
    <select id="orc-servico" data-campo="servico" required aria-describedby="orc-servico-err">
      <option value="">Escolha um serviço</option>
      {listaCategorias.map(([, rotulo]) => <option value={rotulo}>{rotulo}</option>)}
      <option value="Ainda não sei">Ainda não sei</option>
    </select>
    <p class="field__error" id="orc-servico-err" hidden>Escolha o serviço, ou "Ainda não sei".</p>
  </div>
  <div class="field">
    <label for="orc-local">Cidade e data</label>
    <input id="orc-local" data-campo="cidade" type="text" autocomplete="address-level2" />
  </div>
  <div class="field field--full">
    <label for="orc-mensagem">O que você imagina</label>
    <textarea id="orc-mensagem" data-campo="mensagem" rows="3" required aria-describedby="orc-mensagem-err"></textarea>
    <p class="field__error" id="orc-mensagem-err" hidden>Conte em uma frase o que você quer fazer.</p>
  </div>
  <div class="btn-row"><button class="btn btn--primary" type="submit">Pedir orçamento</button></div>
  <p class="form__status" role="status" data-form-status></p>
  <p class="t-small muted">O WhatsApp abre com a mensagem pronta. É só enviar.</p>
</form>

<script>
  import { conectarFormularioOrcamento } from '../lib/formulario-orcamento';

  document.querySelectorAll<HTMLFormElement>('form[data-orcamento]').forEach(conectarFormularioOrcamento);
</script>

