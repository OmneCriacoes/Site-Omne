---
import Base from '../layouts/Base.astro';
import HeroInterno from '../components/HeroInterno.astro';
import fotoHero from '../content/projetos/expresso-da-8/02.jpg';
---

<Base titulo="Página não encontrada" descricao="Este endereço não existe no site da Omne Criações.">
  <HeroInterno
    titulo="Página não encontrada"
    texto="Este endereço não existe no site da Omne Criações. Os projetos, os serviços e o pedido de orçamento continuam a um clique."
    foto={fotoHero}
    alt="Placa Beco Mágico em madeira com moldura dourada, sob um brasão em relevo, no Expresso da 8"
    assunto="placa cenográfica do Expresso da 8"
    secundario={{ href: '/projetos/', rotulo: 'Ver os projetos' }}
  />
</Base>
