---
import Base from '../layouts/Base.astro';
---

<Base titulo="Página não encontrada">
  <section class="container nao-encontrada">
    <p class="rotulo">Erro 404</p>
    <h1>Esta página saiu de cena</h1>
    <p>O endereço pode ter mudado. Veja os projetos ou fale com a gente.</p>
    <div class="acoes">
      <a class="botao" href="/projetos/">Ver projetos</a>
      <a class="botao botao--contorno" href="/">Ir para o início</a>
    </div>
  </section>
</Base>

<style>
  .nao-encontrada { display: grid; gap: 18px; justify-items: start; padding-block: clamp(64px, 12vw, 160px); }
  .acoes { display: flex; flex-wrap: wrap; gap: 12px; }
</style>
