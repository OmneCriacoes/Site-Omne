---
import type { ImageMetadata } from 'astro';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Midia from '../components/Midia.astro';
import CartaoProjeto from '../components/CartaoProjeto.astro';
import FaixaClientes from '../components/FaixaClientes.astro';
import Processo from '../components/Processo.astro';
import ChamadaOrcamento from '../components/ChamadaOrcamento.astro';
import { site } from '../lib/site';
import { projetosDaCategoria, projetosDestaque } from '../lib/projetos';

const destaques = await projetosDestaque(7);
const [principal, ...demais] = destaques;
const servicos = (await getCollection('servicos')).sort((a, b) => a.data.ordem - b.data.ordem);
// Cada serviço mostra a capa de um projeto diferente, para a vitrine não repetir fotos.
const usados = new Set<string>(principal ? [principal.id] : []);
const capasServicos: (ImageMetadata | undefined)[] = [];
for (const s of servicos) {
  const opcoes = await projetosDaCategoria(s.data.categoria);
  const escolhido = opcoes.find((p) => !usados.has(p.id)) ?? opcoes[0];
  if (escolhido) usados.add(escolhido.id);
  capasServicos.push(escolhido?.data.capa);
}
---

<Base imagem={principal?.data.capa.src}>
  <section class="hero container">
    <div class="hero-texto">
      <p class="rotulo">{site.cidade} · {site.atendimento}</p>
      <h1>{site.hero.titulo}</h1>
      <p class="lead">{site.hero.texto}</p>
      <div class="hero-acoes">
        <a class="botao" href="/orcamento/">Pedir orçamento</a>
        <a class="botao botao--contorno" href="/projetos/">Ver projetos</a>
      </div>
    </div>
    {principal && (
      <a class="hero-foto" href={`/projetos/${principal.id}/`}>
        <Midia src={principal.data.capa} alt={principal.data.titulo} proporcao="5 / 4" tamanhos="(max-width: 900px) 100vw, 55vw" larguras={[640, 960, 1400]} prioridade />
        <span class="selo">{principal.data.titulo}</span>
      </a>
    )}
  </section>

  <section class="secao container" aria-labelledby="titulo-servicos">
    <div class="cabecalho-secao">
      <div>
        <p class="rotulo">O que fazemos</p>
        <h2 id="titulo-servicos">Cinco frentes, uma só equipe</h2>
      </div>
      <a class="link-seta" href="/servicos/">Conhecer os serviços →</a>
    </div>
    <ul class="servicos">
      {servicos.map((s, i) => (
        <li>
          <a href={`/projetos/?categoria=${s.data.categoria}`}>
            {capasServicos[i]
              ? <Midia src={capasServicos[i]} alt="" proporcao="3 / 4" tamanhos="(max-width: 760px) 50vw, 20vw" larguras={[360, 560]} />
              : <div class="sem-foto" aria-hidden="true"><span>Fotos em breve</span></div>}
            <h3>{s.data.titulo}</h3>
            <p>{s.data.chamada}</p>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="secao container" aria-labelledby="titulo-projetos">
    <div class="cabecalho-secao">
      <div>
        <p class="rotulo">Projetos recentes</p>
        <h2 id="titulo-projetos">Do ateliê para shoppings, marcas e exposições</h2>
      </div>
      <a class="link-seta" href="/projetos/">Ver todos os projetos →</a>
    </div>
    <div class="destaques">
      {demais.map((p, i) => <CartaoProjeto projeto={p} grande={i === 0} />)}
    </div>
  </section>

  <Processo />
  <FaixaClientes />
  <ChamadaOrcamento />
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
    padding-block: clamp(40px, 6vw, 88px) 0;
  }
  .hero-texto { display: grid; gap: 22px; }
  .lead { font-size: 1.2rem; max-width: 40ch; }
  .hero-acoes { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 6px; }
  .hero-foto { position: relative; display: block; }
  .selo {
    position: absolute;
    left: 16px;
    bottom: 16px;
    background: var(--c-superficie);
    color: var(--c-tinta);
    font-size: var(--t-pequeno);
    font-weight: 600;
    padding: 6px 12px;
    border-radius: 2px;
  }

  .servicos {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 20px;
  }
  .servicos a { display: grid; gap: 10px; color: inherit; text-decoration: none; align-content: start; }
  .servicos h3 { margin-top: 6px; }
  .sem-foto { aspect-ratio: 3 / 4; border-radius: var(--raio); background: var(--c-tinta); display: grid; place-items: end start; padding: 14px; }
  .sem-foto span { color: var(--c-menta); font-size: 0.78rem; letter-spacing: 0.14em; text-transform: uppercase; font-weight: 600; }
  .servicos a:hover h3 { color: var(--c-marca); }
  .servicos p { font-size: 0.95rem; }

  .destaques {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 40px 24px;
  }
  .destaques > :global(.grande) { grid-column: span 2; grid-row: span 2; }

  @media (max-width: 1000px) {
    .servicos { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (max-width: 900px) {
    .hero { grid-template-columns: 1fr; }
    .hero-foto { order: -1; }
  }
  @media (max-width: 760px) {
    .servicos { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .destaques { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
