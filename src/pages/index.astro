---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import FormularioOrcamento from '../components/FormularioOrcamento.astro';
import { site } from '../lib/site';
import fotoHero from '../content/projetos/expresso-da-8/11.jpg';
import fotoServicos from '../content/projetos/nike/02.jpg';
import fotoArvorar from '../content/projetos/espaco-arvorar-duratex/02.jpg';
import fotoVila from '../content/projetos/vila-da-crianca/02.jpg';
import fotoBrinquedao from '../content/projetos/brinquedao-magazine-luiza/06.jpg';
import fotoNatal from '../content/projetos/natal-em-shoppings/03.jpg';
import fotoOficina from '../content/projetos/cow-parade/13.jpg';

const servicos = (await getCollection('servicos')).sort((a, b) => a.data.ordem - b.data.ordem);
const etapas = await getCollection('etapas');
const totalProjetos = (await getCollection('projetos')).length;

const capitulos = [
  { foto: fotoArvorar, alt: 'Painel ilustrado com mapa em relevo na exposição Espaço Arvorar', titulo: 'Espaço Arvorar, para a Duratex', texto: 'Exposição itinerante sobre florestas e biodiversidade, com murais ilustrados, painéis e cenografia. Bauru, SP.', link: '/projetos/espaco-arvorar-duratex/' },
  { foto: fotoVila, alt: 'Cidade cenográfica com casinhas, pneus coloridos e moinho na Vila da Criança', titulo: 'Vila da Criança', texto: 'Cidade cenográfica infantil com casinhas, praça, pneus pintados e brinquedos, montada dentro de um shopping.', link: '/projetos/vila-da-crianca/' },
  { foto: fotoBrinquedao, alt: 'Teatrinho com parede curva de ripas de madeira no Brinquedão Magazine Luiza', titulo: 'Brinquedão Magazine Luiza', texto: 'Espaços de brincar nas lojas Aricanduva e Tietê, em São Paulo, com teatrinho, castelo e brinquedos sob medida.', link: '/projetos/brinquedao-magazine-luiza/' },
];
---

<Base momentos={['photo-chapters', 'picture-develops']}>
  <section class="hero hero--photo" data-enter data-calm="left" aria-labelledby="hero-h">
    <Image class="hero__bg" src={fotoHero} widths={[1280, 1920, 2000]} sizes="100vw" alt="Fachada cenográfica da loja Baú do Bruxo, com coruja e lustres de papel, no Expresso da 8" style="--ly-pos: 62% 50%; --ly-pos-phone: 72% 50%" loading="eager" fetchpriority="high" data-source="client" data-subject="espaço temático Expresso da 8" />
    <div class="wrap"><div class="hero-text">
      <div class="hero__text">
        <h1 id="hero-h">{site.hero.titulo}</h1>
        <p class="hero__lead">{site.hero.texto}</p>
        <div class="btn-row"><a class="btn btn--primary" href="/orcamento/">Pedir orçamento</a><a class="btn btn--secondary" href="/projetos/">Ver os projetos</a></div>
      </div>
    </div></div>
  </section>

  <section class="section" id="servicos" style="--hm: 2" aria-labelledby="servicos-h">
    <div class="wrap">
      <div class="grid grid--top fill">
        <div class="span-5">
          <div class="section-head">
            <h2 id="servicos-h">Esculturas, murais, mesas e espaços</h2>
            <p>Criação, modelagem, pintura, transporte e montagem ficam com a mesma equipe.</p>
          </div>
          <ul class="rows">
            {servicos.map((s) => (
              <li><span class="rows__name">{s.data.titulo}</span><p>{s.data.menu}</p></li>
            ))}
          </ul>
          <p class="servicos__link"><a class="link" href="/servicos/">Ver os serviços em detalhe</a></p>
        </div>
        <div class="frame frame--photo span-6 start-7" style="--ratio: 100%">
          <Image class="frame__img" src={fotoServicos} widths={[900, 1280]} sizes="900px" alt="Bustos recortados em painéis e pedestais com tênis sob cúpulas na ativação Nike" loading="lazy" data-source="client" data-subject="ativação de marca Nike" />
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="projetos" data-moment="photo-chapters" aria-labelledby="projetos-h">
    <div class="wrap mo-ph">
      <div class="mo-ph__head">
        <h2 id="projetos-h">Projetos de cenografia entregues</h2>
        <p>Três dos {totalProjetos} trabalhos do portfólio, de exposição itinerante a área de brincar. <a class="link" href="/projetos/">Ver todos os projetos</a></p>
      </div>
      <ol class="mo-ph__list">
        {capitulos.map((c) => (
          <li class="mo-ph__ch">
            <figure class="mo-ph__pic"><Image src={c.foto} widths={[900, 1280, 2000]} sizes="(max-width: 639px) 900px, (min-width: 1440px) 1280px, 100vw" alt={c.alt} data-source="client" data-subject={c.titulo} /></figure>
            <h3><a href={c.link}>{c.titulo}</a></h3>
            <p>{c.texto}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section ground-inverse" id="oficina" style="--hm: 2" aria-labelledby="oficina-h">
    <div class="wrap">
      <div class="grid grid--top fill">
        <div class="span-6">
          <div class="section-head">
            <h2 id="oficina-h">Esculturas feitas na nossa oficina</h2>
            <p>{site.sobre.texto}</p>
          </div>
          <ul class="rows">
            {etapas.map((e) => (
              <li><span class="rows__name">{e.data.titulo}</span><p>{e.data.texto}</p></li>
            ))}
          </ul>
        </div>
        <figure class="develop span-6 start-7" data-moment="picture-develops">
          <Image src={fotoOficina} widths={[1000, 1600, 2000]} sizes="1000px" alt="Vaca de fibra de vidro dirigindo um carro laranja, pronta na oficina da Omne para a Cow Parade" loading="lazy" data-source="client" data-subject="escultura da Cow Parade na oficina" />
        </figure>
      </div>
    </div>
  </section>

  <section class="section" id="orcamento" style="--hm: 2" aria-labelledby="orcamento-h">
    <div class="wrap">
      <div class="grid grid--top fill">
        <div class="span-5">
          <div class="section-head">
            <h2 id="orcamento-h">Orçamento de cenografia pelo WhatsApp</h2>
            <p>Preencha os campos e o WhatsApp abre com a mensagem pronta para a Omne. {site.atendimento}, a partir de {site.cidade}.</p>
          </div>
          <div class="frame frame--photo orcamento__foto" style="--ratio: 63%">
            <Image class="frame__img" src={fotoNatal} widths={[700, 1393]} sizes="700px" alt="Papai Noel gigante lendo o livro Fábulas de Natal, com quebra-nozes e Mamãe Noel, num shopping" loading="lazy" data-source="client" data-subject="decoração de Natal em shopping" />
          </div>
        </div>
        <div class="card span-6 start-7 orcamento__card">
          <FormularioOrcamento />
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .servicos__link { margin-top: var(--s-6); }
  .orcamento__foto { margin-top: var(--s-7); }
  .orcamento__card { align-self: start; }
  /* picture-develops: a foto da seção, na coluna direita, da altura do texto ao lado */
  .develop { margin: 0; border-radius: var(--r-lg); overflow: hidden; height: min(560px, var(--ly-fit)); }
  .develop :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }
  @media (max-width: 1023px) { .develop { height: auto; aspect-ratio: 4 / 3; margin-top: var(--s-7); } }
  /* no telefone a seção tem duas telas: a foto mais alta enche a segunda, e o orçamento ganha uma foto maior */
  @media (max-width: 639px) { .develop { aspect-ratio: 3 / 4; } .orcamento__foto { --ratio: 100% !important; } }
  @media (max-width: 359px) { .develop { aspect-ratio: 4 / 3; } }
</style>
