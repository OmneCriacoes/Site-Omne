---
import { container } from '@core/container';
import BaseLayout from '@layouts/BaseLayout.astro';
import QuoteForm from '@components/sections/QuoteForm.astro';
import Icon from '@components/ui/Icon.astro';
import SectionHeading from '@components/ui/SectionHeading.astro';

const [settings, services, contact] = await Promise.all([
  container.site.getSettings(),
  container.catalog.list(),
  container.contact(),
]);
const info = settings.contact;
---

<BaseLayout title="Contato" description="Solicite um orçamento de cenografia, esculturas, murais, mesas ou espaços temáticos.">
  <section class="container page">
    <div class="side">
      <SectionHeading
        as="h1"
        eyebrow="Contato"
        title="Vamos conversar sobre o seu projeto"
        intro="Preencha o formulário e escolha como prefere enviar. Se preferir, fale direto com a gente."
      />
      <ul class="channels">
        <li>
          <a href={contact.whatsappLink()} target="_blank" rel="noopener" data-sk="text">
            <Icon name="chat" /> WhatsApp {info.phoneDisplay}
          </a>
        </li>
        <li>
          <a href={`mailto:${info.email}`} data-sk="text"><Icon name="mail" /> {info.email}</a>
        </li>
        <li data-sk="text"><Icon name="pin" /> {info.city}</li>
      </ul>
    </div>
    <div class="panel">
      <QuoteForm services={services} contact={info} />
    </div>
  </section>
</BaseLayout>

<script>
  const slug = new URLSearchParams(location.search).get('servico');
  const select = document.querySelector<HTMLSelectElement>('#service');
  const match = slug && select ? [...select.options].find((o) => o.dataset.slug === slug) : undefined;
  if (match) match.selected = true;
</script>

<style>
  .page {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: var(--space-8);
    padding-block: var(--space-9);
  }

  .channels {
    display: grid;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .channels li,
  .channels a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
    word-break: break-word;
  }

  .panel {
    padding: var(--space-7);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  @media (max-width: 860px) {
    .page {
      grid-template-columns: 1fr;
    }

    .panel {
      padding: var(--space-5);
    }
  }
</style>
