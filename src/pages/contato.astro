---
import { container } from '@core/container';
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/sections/Hero.astro';
import QuoteSection from '@components/sections/QuoteSection.astro';
import Statement from '@components/sections/Statement.astro';

const [settings, services] = await Promise.all([container.site.getSettings(), container.catalog.list()]);
---

<BaseLayout title="Orçamento de cenografia pelo WhatsApp" description="Peça o orçamento de esculturas, murais, mesas ou espaços temáticos: o WhatsApp da Omne Criações abre com a sua mensagem pronta." moments={['word-highlight']}>
  <Hero
    title="Orçamento de cenografia pelo WhatsApp"
    lead="Conte a ideia, o local e a data, para 1 peça ou o espaço inteiro. A conversa segue pelo WhatsApp com a equipe que vai desenhar, fabricar e montar a peça."
    image={{ src: '/uploads/projetos/brinquedao-magazine-luiza/01.webp', alt: 'Castelo azul de brincar com escorregadores verdes, feito para o Brinquedão Magazine Luiza' }}
    subject="área de brincar do Brinquedão Magazine Luiza"
    secondary={{ href: '/portfolio', label: 'Ver o portfólio' }}
  />

  <Statement id="como" label="O pedido">Um nome, o serviço e uma frase sobre a ideia bastam para começar; o <strong>local e a data</strong> ajudam a oficina a dar o prazo.</Statement>

  <QuoteSection
    title="Pedido de orçamento"
    image={{ src: '/uploads/projetos/expresso-da-8/11.webp', alt: 'Fachada cenográfica da loja Baú do Bruxo, com coruja e lustres de papel, no Expresso da 8' }}
    subject="espaço temático Expresso da 8"
    services={services}
    contact={settings.contact}
  />
</BaseLayout>
