---
import Base from '../layouts/Base.astro';
import Midia from '../components/Midia.astro';
import Processo from '../components/Processo.astro';
import FaixaClientes from '../components/FaixaClientes.astro';
import ChamadaOrcamento from '../components/ChamadaOrcamento.astro';
import { site } from '../lib/site';
import { projetosDestaque } from '../lib/projetos';

const fotos = (await projetosDestaque(3)).map((p) => p.data.capa);
---

<Base titulo="Sobre" descricao={site.sobre.texto}>
  <section class="container sobre">
    <div class="texto">
      <p class="rotulo">Sobre a Omne</p>
      <h1>{site.sobre.titulo}</h1>
      <p class="lead">{site.sobre.texto}</p>
      <p>{site.cidade} · {site.atendimento}</p>
    </div>
    <div class="fotos">
      {fotos.map((f, i) => <Midia src={f} alt="" proporcao={i === 0 ? '4 / 5' : '1 / 1'} tamanhos="(max-width: 900px) 50vw, 25vw" larguras={[400, 700]} prioridade={i === 0} />)}
    </div>
  </section>
  <Processo />
  <FaixaClientes />
  <ChamadaOrcamento />
</Base>

<style>
  .sobre {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
    padding-block: clamp(40px, 6vw, 88px) 0;
  }
  .texto { display: grid; gap: 20px; }
  .lead { font-size: 1.15rem; max-width: 52ch; }
  .fotos { display: grid; grid-template-columns: 1.2fr 1fr; gap: 12px; }
  .fotos > :first-child { grid-row: span 2; }
  @media (max-width: 900px) { .sobre { grid-template-columns: 1fr; } }
</style>
