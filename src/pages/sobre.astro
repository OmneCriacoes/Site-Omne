---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import HeroInterno from '../components/HeroInterno.astro';
import { site } from '../lib/site';
import { todosProjetos } from '../lib/projetos';
import fotoHero from '../content/projetos/cow-parade/13.jpg';
import fotoProcesso from '../content/projetos/vassoura-quebrada/01.jpg';
import fotoClientes from '../content/projetos/natal-em-shoppings/03.jpg';

const etapas = await getCollection('etapas');
const projetos = await todosProjetos();
// os clientes com projeto no site viram linhas com o que foi feito; os outros, uma linha de nomes
const comProjeto = projetos.filter((p) => p.data.cliente).slice(0, 5);
const nomesComProjeto = comProjeto.map((p) => p.data.cliente.toLowerCase());
const outrosClientes = (await getCollection('clientes'))
  .map((c) => c.data.nome)
  .filter((nome) => !nomesComProjeto.some((n) => n.includes(nome.toLowerCase())));
const lista = (nomes: string[]) => (nomes.length > 1 ? `${nomes.slice(0, -1).join(', ')} e ${nomes.at(-1)}` : nomes.join(''));
---

<Base titulo={site.sobre.titulo} descricao={site.sobre.texto} momentos={['picture-develops']} atual="Sobre">
  <HeroInterno
    titulo={site.sobre.titulo}
    texto={`A mesma equipe desenha, modela, pinta, transporta e monta cada peça. ${site.atendimento}, com ${projetos.length} projetos no portfólio.`}
    foto={fotoHero}
    alt="Vaca de fibra de vidro dirigindo um carro laranja, na oficina da Omne, entre placas de isopor e madeira"
    assunto="escultura da Cow Parade na oficina"
    posicao="50% 40%"
    secundario={{ href: '/projetos/', rotulo: 'Ver os projetos' }}
  />

  <section class="section" id="processo" style="--hm: 2" aria-labelledby="processo-h">
    <div class="wrap">
      <div class="grid grid--top fill">
        <div class="span-5">
          <div class="section-head">
            <h2 id="processo-h">Etapas de um projeto de cenografia</h2>
            <p>Quatro etapas, com a mesma equipe em todas.</p>
          </div>
          <ul class="rows">
            {etapas.map((e) => <li><span class="rows__name">{e.data.titulo}</span><p>{e.data.texto}</p></li>)}
          </ul>
        </div>
        <figure class="develop span-6 start-7" data-moment="picture-develops">
          <Image src={fotoProcesso} widths={[1000, 1500]} sizes="1000px" alt="Escultura de um maquinista de barba e lanterna, de pé sobre um baú, na oficina" loading="lazy" style="object-position: 50% 25%" data-source="client" data-subject="escultura Vassoura Quebrada" />
        </figure>
      </div>
    </div>
  </section>

  <section class="section" id="clientes" style="--hm: 2" aria-labelledby="clientes-h">
    <div class="wrap">
      <div class="grid grid--top fill">
        <div class="span-5">
          <div class="section-head">
            <h2 id="clientes-h">Clientes e o que fizemos para eles</h2>
            <p>Também atendemos {lista(outrosClientes)}.</p>
          </div>
          <ul class="rows">
            {comProjeto.map((p) => <li><span class="rows__name">{p.data.cliente}</span><p><a class="link" href={`/projetos/${p.id}/`}>{p.data.titulo}</a></p></li>)}
          </ul>
        </div>
        <div class="frame frame--photo span-6 start-7" style="--ratio: 63%">
          <Image class="frame__img" src={fotoClientes} widths={[700, 1393]} sizes="700px" alt="Papai Noel gigante lendo o livro Fábulas de Natal, com quebra-nozes e Mamãe Noel, num shopping" loading="lazy" data-source="client" data-subject="decoração de Natal em shopping" />
        </div>
      </div>
    </div>
  </section>
</Base>
