---
import Base from '../layouts/Base.astro';
import HeroInterno from '../components/HeroInterno.astro';
import SecaoOrcamento from '../components/SecaoOrcamento.astro';
import fotoHero from '../content/projetos/brinquedao-magazine-luiza/01.jpg';
import fotoForm from '../content/projetos/natal-em-shoppings/03.jpg';
---

<Base titulo="Orçamento de cenografia pelo WhatsApp" descricao="Peça o orçamento de esculturas, murais, mesas ou espaços temáticos: o WhatsApp da Omne Criações abre com a sua mensagem pronta." momentos={['picture-develops']}>
  <HeroInterno
    titulo="Orçamento de cenografia pelo WhatsApp"
    texto="Conte a ideia, o local e a data, para 1 peça ou o espaço inteiro. A conversa segue pelo WhatsApp com a equipe que vai desenhar, fabricar e montar a peça."
    foto={fotoHero}
    alt="Castelo azul de brincar com escorregadores verdes, feito para o Brinquedão Magazine Luiza"
    assunto="área de brincar do Brinquedão Magazine Luiza"
    secundario={{ href: '/projetos/', rotulo: 'Ver os projetos' }}
  />
  <SecaoOrcamento
    titulo="Pedido de orçamento"
    foto={fotoForm}
    alt="Papai Noel gigante lendo o livro Fábulas de Natal, com quebra-nozes e Mamãe Noel, num shopping"
    assunto="decoração de Natal em shopping"
    revela
  />
</Base>
