---
import type { GetStaticPaths } from 'astro';
import { container } from '@core/container';
import type { Service } from '@domain/entities';
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/sections/Hero.astro';
import ProjectGrid from '@components/sections/ProjectGrid.astro';
import Statement from '@components/sections/Statement.astro';

export const getStaticPaths = (async () => {
  const services = await container.catalog.list();
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}) satisfies GetStaticPaths;

interface Props {
  service: Service;
}

const { service } = Astro.props;
const projects = await container.portfolio.list({ service: service.slug });
// a foto ao lado do que inclui: uma vista de um projeto deste serviço, nunca a capa do hero
const sidePhoto = projects.flatMap((p) => p.gallery).find((img) => img.src !== service.cover.src && !projects.some((p) => p.cover.src === img.src));
---

<BaseLayout title={service.title} description={service.summary} image={service.cover.src} moments={['word-highlight']}>
  <Hero
    title={service.title}
    lead={service.summary}
    image={service.cover}
    subject={service.title}
    secondary={{ href: '/servicos', label: 'Ver os serviços' }}
  />

  <Statement id="resumo" label={service.title}>Do desenho à montagem, cada peça de {service.title.toLowerCase()} fica com a <strong>mesma equipe</strong>, que fala com você do primeiro esboço à inauguração.</Statement>

  <section class="section" id="inclui" aria-labelledby="inclui-h">
    <div class="wrap">
      <div class="grid grid--top fill">
        <div class="span-5">
          <div class="section-head">
            <h2 id="inclui-h">O que o serviço de {service.title.toLowerCase()} inclui</h2>
            {service.descriptionHtml && <div class="service__text" set:html={service.descriptionHtml} />}
          </div>
          <ul class="rows">{service.highlights.map((h) => <li><span class="rows__name">{h}</span></li>)}</ul>
        </div>
        {sidePhoto && (
          <div class="frame frame--photo span-6 start-7" style="--ratio: 75%">
            <img class="frame__img" src={sidePhoto.src} alt={sidePhoto.alt} loading="lazy" data-source="client" data-subject={service.title} />
          </div>
        )}
      </div>
    </div>
  </section>

  {projects.length > 0 && (
    <ProjectGrid id="projetos" title={`Projetos de ${service.title.toLowerCase()}`} projects={projects} link={{ href: '/portfolio', label: 'Ver o portfólio' }} />
  )}
</BaseLayout>

<style>
  .service__text :global(p) { max-width: 52ch; }
</style>
