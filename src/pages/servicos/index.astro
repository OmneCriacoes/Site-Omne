---
import { container } from '@core/container';
import BaseLayout from '@layouts/BaseLayout.astro';
import CtaBand from '@components/sections/CtaBand.astro';
import ServicesGrid from '@components/sections/ServicesGrid.astro';
import SectionHeading from '@components/ui/SectionHeading.astro';

const [services, contact] = await Promise.all([container.catalog.list(), container.contact()]);
---

<BaseLayout title="Serviços" description="Esculturas, murais, mesas, espaços temáticos e projetos cenográficos sob medida.">
  <div class="container intro">
    <SectionHeading
      as="h1"
      eyebrow="Serviços"
      title="Tudo o que um espaço precisa para contar uma história"
      intro="Contrate uma frente específica ou o projeto completo, com criação, produção e montagem."
    />
  </div>
  <ServicesGrid services={services} showHeading={false} />
  <CtaBand whatsappLink={contact.whatsappLink()} />
</BaseLayout>

<style>
  .intro {
    padding-top: var(--space-9);
  }

  .intro :global(.heading) {
    margin-bottom: 0;
  }
</style>
