---
import type { GetStaticPaths } from 'astro';
import { container } from '@core/container';
import { SEGMENT_LABELS, type Project } from '@domain/entities';
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/sections/Hero.astro';
import ProjectGrid from '@components/sections/ProjectGrid.astro';
import Statement from '@components/sections/Statement.astro';

export const getStaticPaths = (async () => {
  const projects = await container.portfolio.list();
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}) satisfies GetStaticPaths;

interface Props {
  project: Project;
}

const { project } = Astro.props;
const [services, related] = await Promise.all([container.catalog.list(), container.portfolio.related(project, 3)]);
const serviceList = services.filter((s) => project.serviceSlugs.includes(s.slug));
const facts = [
  { label: 'Cliente', value: project.clientName },
  { label: 'Segmento', value: SEGMENT_LABELS[project.segment] },
  { label: 'Local', value: project.location },
  { label: 'Ano', value: project.year ? String(project.year) : '' },
].filter((f) => f.value);

// a capa abre o hero; a segunda foto fica ao lado da ficha; as outras enchem linhas inteiras numa tela
const photos = project.gallery.filter((img) => img.src !== project.cover.src);
const [factsPhoto, ...rest] = photos;
const count = [8, 6, 4, 3, 2].find((n) => rest.length >= n) ?? 0;
const perRow = count === 6 ? 3 : Math.min(count, 4);
const grid = rest.slice(0, count);
const where = [project.clientName, project.location].filter(Boolean).join(', ');
const serviceNoun = { esculturas: 'esculturas', murais: 'murais e cenografia', mesas: 'mesas cenográficas', 'espacos-tematicos': 'cenografia temática', projetos: 'projeto cenográfico' }[project.serviceSlugs[0]] ?? 'cenografia';
const photoCount = project.gallery.length || 1;
---

<BaseLayout title={project.title} description={project.summary} image={project.cover.src} moments={['word-highlight']}>
  <Hero
    title={`${project.title}, ${serviceNoun}`}
    lead={`${project.summary}${where ? ` ${where}.` : ''} ${photoCount} ${photoCount === 1 ? 'foto' : 'fotos'} do trabalho pronto nesta página.`}
    image={project.cover}
    subject={project.title}
    secondary={{ href: '/portfolio', label: 'Ver o portfólio' }}
  />

  <Statement id="resumo" label={project.title}>O projeto {project.title} foi desenhado, feito e montado pela <strong>mesma equipe</strong>, do primeiro esboço à inauguração.</Statement>

  {factsPhoto && (
    <section class="section" id="ficha" style="--hm: 2" aria-labelledby="ficha-h">
      <div class="wrap">
        <div class="grid grid--top fill">
          <div class="span-5">
            <div class="section-head">
              <h2 id="ficha-h">Ficha do projeto</h2>
              {project.bodyHtml && <div class="ficha__text" set:html={project.bodyHtml} />}
            </div>
            <ul class="rows">
              {facts.map((f) => <li><span class="rows__name">{f.label}</span><p>{f.value}</p></li>)}
              <li><span class="rows__name">Serviços</span><p>{serviceList.map((s, i) => <>{i > 0 && ', '}<a class="link" href={`/servicos/${s.slug}`}>{s.title}</a></>)}</p></li>
            </ul>
          </div>
          <div class="frame frame--photo span-6 start-7" style="--ratio: 75%">
            <img class="frame__img" src={factsPhoto.src} alt={factsPhoto.alt} loading="lazy" data-source="client" data-subject={project.title} />
          </div>
        </div>
      </div>
    </section>
  )}

  {grid.length > 0 && (
    <section class="section photo-grid" id="fotos" aria-labelledby="fotos-h">
      <div class="wrap">
        <div class="section-head"><h2 id="fotos-h">Fotos do {project.title}</h2></div>
        <div class="wall" style={`--wall-cols: ${perRow}`} data-count={grid.length}>
          {grid.map((img) => (
            <figure class="wall__pic"><img src={img.src} alt={img.alt} loading="lazy" data-source="client" data-subject={project.title} /></figure>
          ))}
        </div>
      </div>
    </section>
  )}

  <ProjectGrid id="outros" title="Outros projetos da oficina" projects={related} link={{ href: '/portfolio', label: 'Ver todos os projetos' }} />
</BaseLayout>

<style>
  .ficha__text :global(p) { max-width: 52ch; }
</style>
