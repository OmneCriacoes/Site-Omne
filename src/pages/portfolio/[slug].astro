---
import type { GetStaticPaths } from 'astro';
import { container } from '@core/container';
import { SEGMENT_LABELS, type Project } from '@domain/entities';
import BaseLayout from '@layouts/BaseLayout.astro';
import CtaBand from '@components/sections/CtaBand.astro';
import ProjectGrid from '@components/sections/ProjectGrid.astro';
import Media from '@components/ui/Media.astro';
import SectionHeading from '@components/ui/SectionHeading.astro';

export const getStaticPaths = (async () => {
  const projects = await container.portfolio.list();
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}) satisfies GetStaticPaths;

interface Props {
  project: Project;
}

const { project } = Astro.props;
const [services, related, contact] = await Promise.all([
  container.catalog.list(),
  container.portfolio.related(project, 3),
  container.contact(),
]);
const serviceList = services.filter((service) => project.serviceSlugs.includes(service.slug));
const facts = [
  { label: 'Cliente', value: project.clientName },
  { label: 'Segmento', value: SEGMENT_LABELS[project.segment] },
  { label: 'Local', value: project.location },
  { label: 'Ano', value: project.year ? String(project.year) : '' },
].filter((fact) => fact.value);
---

<BaseLayout title={project.title} description={project.summary} image={project.cover.src}>
  <article>
    <header class="container head">
      <SectionHeading as="h1" eyebrow="Projeto" title={project.title} intro={project.summary} />
      <dl class="facts">
        {
          facts.map((fact) => (
            <div>
              <dt data-sk="text">{fact.label}</dt>
              <dd data-sk="text">{fact.value}</dd>
            </div>
          ))
        }
        <div>
          <dt data-sk="text">Serviços</dt>
          <dd>
            {
              serviceList.map((service, index) => (
                <>
                  {index > 0 && ', '}
                  <a href={`/servicos/${service.slug}`} data-sk="text">
                    {service.title}
                  </a>
                </>
              ))
            }
          </dd>
        </div>
      </dl>
    </header>

    <div class="container">
      <Media image={project.cover} ratio="16 / 9" eager />
    </div>

    <div class="container body">
      <div class="prose" data-sk="text" set:html={project.bodyHtml} />
    </div>

    {
      project.gallery.length > 0 && (
        <div class="container gallery">
          {project.gallery.map((image) => (
            <Media image={image} ratio="4 / 3" />
          ))}
        </div>
      )
    }
  </article>

  {
    related.length > 0 && (
      <section class="container related">
        <SectionHeading eyebrow="Veja também" title="Projetos relacionados" />
        <ProjectGrid projects={related} services={services} />
      </section>
    )
  }

  <CtaBand title="Quer algo parecido?" whatsappLink={contact.whatsappLink(`Olá! Vi o projeto "${project.title}" no site e gostaria de algo parecido.`)} />
</BaseLayout>

<style>
  .head {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: var(--space-7);
    align-items: end;
    padding-block: var(--space-9) var(--space-7);
  }

  .head :global(.heading) {
    margin-bottom: 0;
  }

  .facts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
    margin: 0;
  }

  dt {
    color: var(--color-ink-soft);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  dd {
    margin: var(--space-1) 0 0;
  }

  .body {
    max-width: 46rem;
    padding-block: var(--space-7);
  }

  .prose {
    font-size: var(--text-lg);
    color: var(--color-ink-soft);
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    gap: var(--space-5);
  }

  .related {
    padding-block: var(--space-9);
  }

  @media (max-width: 860px) {
    .head {
      grid-template-columns: 1fr;
    }
  }
</style>
