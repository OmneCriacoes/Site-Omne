---
import { container } from '@core/container';
import type { Project } from '@domain/entities';
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/sections/Hero.astro';
import ProjectGrid from '@components/sections/ProjectGrid.astro';
import Statement from '@components/sections/Statement.astro';

const [projects, services] = await Promise.all([container.portfolio.list(), container.catalog.list()]);
// cada projeto aparece uma vez, na seção do seu primeiro serviço; serviços sem projeto não abrem seção
const groups = services
  .map((service) => ({ service, items: projects.filter((p: Project) => p.serviceSlugs[0] === service.slug) }))
  .filter((g) => g.items.length > 0);
---

<BaseLayout title="Portfólio de cenografia e esculturas" description={`${projects.length} projetos da Omne Criações para shoppings, marcas, instituições e eventos.`} moments={['word-highlight']}>
  <Hero
    title="Portfólio de cenografia e esculturas"
    lead={`${projects.length} projetos entregues para shoppings, marcas, instituições e eventos, cada um com as fotos da peça pronta no lugar.`}
    image={{ src: '/uploads/projetos/expresso-da-8/01.webp', alt: 'Fachada cenográfica da loja Baú do Bruxo com um troll em tamanho real no Expresso da 8' }}
    subject="espaço temático Expresso da 8"
    position="45% 50%"
    secondary={{ href: '/servicos', label: 'Ver os serviços' }}
  />

  <Statement id="numeros" label="O portfólio">Da casa do Noel num shopping a uma exposição itinerante sobre florestas, as peças são <strong>desenhadas e feitas</strong> pela mesma oficina em São Paulo.</Statement>

  {groups.map(({ service, items }) => (
    <ProjectGrid id={service.slug} title={`Projetos de ${service.title.toLowerCase()}`} text={service.summary} projects={items} link={{ href: `/servicos/${service.slug}`, label: `Ver o serviço de ${service.title.toLowerCase()}` }} />
  ))}
</BaseLayout>
